FROM archlinux:latest

# Fix pacman keyring first (common Arch Docker issue)
RUN pacman-key --init && \
    pacman-key --populate archlinux && \
    pacman -Syu --noconfirm

# Install Hyprland and dependencies
RUN pacman -S --noconfirm \
    hyprland \
    waybar \
    kitty \
    ttf-jetbrains-mono \
    noto-fonts-emoji \
    xorg-xwayland \
    wayvnc \
    xdg-utils \
    sudo \
    git \
    neovim \
    dunst \
    rofi \
    qt5-wayland \
    qt6-wayland && \
    pacman -Scc --noconfirm

# Create rice user
RUN useradd -m rice && \
    echo "rice ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Set up default config directories
RUN mkdir -p /home/rice/.config/hypr && \
    mkdir -p /home/rice/.config/waybar && \
    mkdir -p /home/rice/.config/kitty && \
    mkdir -p /home/rice/.config/dunst && \
    mkdir -p /home/rice/.config/rofi && \
    mkdir -p /home/rice/rices

# Copy default configs
COPY hyprland.conf /home/rice/.config/hypr/
COPY waybar-config /home/rice/.config/waybar/config
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER rice
WORKDIR /home/rice

ENV WAYLAND_DISPLAY=wayland-1
ENV XDG_RUNTIME_DIR=/tmp/runtime-rice
ENV WLR_BACKENDS=headless
ENV WLR_LIBINPUT_NO_DEVICES=1

EXPOSE 5900
CMD ["/entrypoint.sh"]